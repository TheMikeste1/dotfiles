{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/ling-3.0-flash-fin-free",
  "subagent_depth": 2,
  "permission": {
    "task": {
      "*-fiend": "deny",
    },
  },
  "agent": {
    "architect": {
      "model": "opencode/nemotron-3-ultra-free",
      "variant": "high",
    },

    "code-reviewer": {
      "model": "opencode/ling-3.0-flash-fin-free",
      "variant": "high",
    },

    "developer": {
      "model": "opencode/big-pickle",
    },

    "dungeon-delver": {
      "model": "opencode/ling-3.0-flash-fin-free",
      "variant": "high",
    },

    "lexicographer-fiend": {
      "model": "opencode/nemotron-3-ultra-free",
      "variant": "high",
    },

    "remembrancer": {
      "model": "opencode/nemotron-3-ultra-free",
      "variant": "high",
      "permission": {
        "task": {
          "*-fiend": "allow",
        },
      },
    },

    "tensor-fiend": {
      "model": "opencode/nemotron-3-ultra-free",
      "variant": "high",
    },
  },
}
