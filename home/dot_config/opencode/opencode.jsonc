{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 2,
  },
  "permissions": [
    { "action": "subagent", "resource": "*-fiend", "effect": "deny" },
  ],
  "agents": {
    "architect": {
      "model": "<model>#high",
    },

    "code-reviewer": {
      "model": "<model>#high",
    },

    "developer": {
    },

    "dungeon-delver": {
      "model": "<model>#high",
    },

    "lexicographer-fiend": {
      "model": "<model>#high",
    },

    "remembrancer": {
      "model": "<model>#high",
      "permissions": [
        { "action": "subagent", "resource": "*-fiend", "effect": "allow" },
      ],
    },

    "tensor-fiend": {
      "model": "<model>#high",
    },
  },
}
