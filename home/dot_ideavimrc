" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc

" --- Enable IdeaVim plugins https://jb.gg/ideavim-plugins
set which-key
Plug 'bkad/CamelCaseMotion'
Plug 'easymotion/vim-easymotion'
Plug 'machakann/vim-highlightedyank'
Plug 'preservim/nerdtree'
Plug 'tpope/vim-abolish'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-surround'
set peekaboo
set functiontextobj

" --- Settings
"set clipboard^=ideaput
set clipboard+=unnamed
set clipboard+=unnamedplus
set relativenumber
set notimeout
set incsearch
set scrolloff=5
set easymotion

let g:qs_primary_color   = '#afff5f'
let g:qs_secondary_color = '#5fffff'

" -- Prevent paste from overwriting the current yank buffer
xnoremap p P

" --- Keybinds
" Map IDE actions to IdeaVim -- https://jb.gg/abva4t
" Don't use Ex mode, use Q for formatting.
map Q gq
map <leader><C-e> :NERDTree<CR>
map <leader>bb <Action>(ToggleLineBreakpoint)
map <leader>d <Action>(Debug)
map <leader>e <Action>(ShowErrorDescription)
map grn <Action>(RenameElement)

nmap crs <Plug>(abolish-coerce-snake)
nmap crm <Plug>(abolish-coerce-pascal)
nmap crc <Plug>(abolish-coerce-camel)
nmap cru <Plug>(abolish-coerce-upper_snake)
nmap cr- <Plug>(abolish-coerce-kebab)
nmap cr. <Plug>(abolish-coerce-dot)
nmap cr<Space> <Plug>(abolish-coerce-space)
nmap crt <Plug>(abolish-coerce-title)

map <silent> <Space>w <Plug>CamelCaseMotion_w
map <silent> <Space>b <Plug>CamelCaseMotion_b
map <silent> <Space>e <Plug>CamelCaseMotion_e
map <silent> <Space>ge <Plug>CamelCaseMotion_ge

"source ~/.vimrc
